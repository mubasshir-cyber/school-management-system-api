# Application Config
PORT=5000
NODE_ENV=development
API_PREFIX=api/v1

# Multi-Tenant & Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=school_erp_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Initial Seed Credentials (Used only for local dev seeding)
INITIAL_ADMIN_EMAIL=admin@school.edu
INITIAL_ADMIN_PASSWORD=Admin@2026

# JWT Authentication
JWT_SECRET=super-secure-school-erp-jwt-secret-key-2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secure-school-erp-refresh-secret-key-2026
JWT_REFRESH_EXPIRATION=7d

# Cache & Message Queue (Redis & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (S3 / Local / Supabase)
STORAGE_TYPE=local
STORAGE_BUCKET=school-erp-documents
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
